{
  "name": "excalidraw-hotel-visualizer",
  "version": "1.0.0",
  "description": "Generate Excalidraw visualizations for hotel AI front desk system YouTube content",
  "main": "src/index.js",
  "bin": {
    "hotel-viz": "src/cli.js"
  },
  "scripts": {
    "dev": "node server/index.js & npx vite --config vite.config.js",
    "server": "node server/index.js",
    "client": "npx vite --config vite.config.js",
    "generate": "node src/cli.js",
    "example": "node src/cli.js --template all --output examples/"
  },
  "keywords": [
    "excalidraw",
    "hotel",
    "ai",
    "visualization",
    "front-desk"
  ],
  "license": "MIT",
  "type": "module",
  "directories": {
    "example": "examples"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:49664/git/stjernepatches-source/Excalidraw-agents"
  },
  "author": "",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@vitejs/plugin-react": "^5.1.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.1"
  }
}
